# Local Bash configuration, outside git. delegate.sh exports these settings.
# Choose one model per rail from the installed provider's model catalog.
# MODEL_ROUTER_KEY="your-local-bridge-key"
# BRIDGE_URL="http://127.0.0.1:8317"
# BRIDGE_CONFIG_DIR="$HOME/.claude-bridge"
# GROK_MODEL="grok"
# CODEX_MODEL="choose-from-your-catalog"
# OPENROUTER_MODEL="deepseek"
# CURSOR_MODEL="choose-from-your-catalog"
# GROK_EFFORT="high"
# CODEX_EFFORT="high"

# Native Claude subscription seats. Supply the model as the fourth argument.
# SEAT_WERK="-"
# SEAT_MAX="$HOME/.claude-max"

# Total task limits, shared by explicit resume attempts.
# DELEGATE_MAX_ATTEMPTS=3
# DELEGATE_MAX_SECONDS=900
# DELEGATE_MAX_INPUT_BYTES=65536
# DELEGATE_MAX_OUTPUT_BYTES=16777216
# Optional: prevent another attempt when reported tokens reach this threshold.
# Not an in-flight token cap. Unknown prior usage also blocks a new attempt.
# DELEGATE_MAX_REPORTED_TOKENS=200000
# DELEGATE_STATE_DIR="$HOME/.delegate-state"
# DELEGATE_PYTHON="python"

# Per invocation: DELEGATE_TASK_ID=my-task; DELEGATE_RESUME=1 to resume.
# Reuse the original prompt, context, model, tools, directory and limits.
# DELEGATE_CWD="/path/to/repo"
# DELEGATE_MCP=0
# DELEGATE_SENSITIVE=1
# SENSITIVE_RE='BSN|password|api[_-]?key|secret|klantgegeven|persoonsgegeven'

# Additional context: one path per line, not colon-separated.
# DELEGATE_CONTEXT=$'C:/context/rules.txt\nC:/context/acceptance.txt'
# delegate_context() {
#   if [ -f "$1/backend/app/core/marker.py" ]; then
#     printf '%s\n' "$HOME/context/my-invariants.md"
#   fi
# }
